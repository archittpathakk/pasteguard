# Which AI checks the text: "gemini" (free tier) or "anthropic" (Claude).
AI_PROVIDER=gemini

# Google AI Studio key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Switch back to Claude later by setting AI_PROVIDER=anthropic and filling this.
ANTHROPIC_API_KEY=

# Optional overrides if you want a specific model.
# GEMINI_MODEL=gemini-3.1-flash-lite
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: an n8n webhook that emails or Slacks the admin.
# N8N_WEBHOOK_URL=

# Password for the admin event view. If unset, the admin view is
# unavailable (it fails closed rather than opening to everyone).
ADMIN_PASSWORD=

# PostgreSQL for the audit log. Unset means in-memory demo storage,
# which is NOT durable. See docs/DATABASE.md.
DATABASE_URL=
